# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts

# Native
# ios/ and android/ are both committed (bare workflow)
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env
*.ipa
*.aab

# Claude Code metadata
.claude/

# QPC V2 staging payload — ~500 MB of source SVG/font archives + extracted
# scratch files used only to derive assets/fonts/qcf-v2/ + assets/mushaf-v2/.
# Not needed at runtime; never committed.
qul-v2-staging/

# Local Xcode build output for on-device builds. Per-machine, regeneratable.
ios/build_device/
ios/build_device_release/
ios/build/
