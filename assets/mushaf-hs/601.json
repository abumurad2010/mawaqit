{"page": 601, "ayahs": [{"surah": 103, "ayah": 1, "line_start": 3, "line_end": 3, "text": "‏‏‏‏‏‏ ‏"}, {"surah": 103, "ayah": 2, "line_start": 3, "line_end": 3, "text": "‏‏ ‏‏‏‏‏ ‏‏ ‏‏‏ ‏"}, {"surah": 103, "ayah": 3, "line_start": 3, "line_end": 4, "text": "‏‏ ‏‏‏‏ ‏‏‏‏‏‏\n‏‏‏‏‏‏ ‏‏‏‏‏‏ ‏‏‏‏‏‏‏ ‏‏‏‏ ‏‏‏‏‏‏‏ ‏‏‏‏‏‏ ‏\n"}, {"surah": 104, "ayah": 1, "line_start": 7, "line_end": 7, "text": "‏‏‏ ‏‏ ‏‏‏‏ ‏‏‏‏ ‏"}, {"surah": 104, "ayah": 2, "line_start": 7, "line_end": 7, "text": "‏‏‏ ‏‏ ‏‏‏ ‏‏‏‏‏‏ ‏\n"}, {"surah": 104, "ayah": 3, "line_start": 8, "line_end": 8, "text": "‏‏‏ ‏‏ ‏‏‏‏ ‏‏‏‏‏ ‏"}, {"surah": 104, "ayah": 4, "line_start": 8, "line_end": 8, "text": "‏‏ ‏‏‏‏‏ ‏ ‏‏‏‏‏ ‏\n"}, {"surah": 104, "ayah": 5, "line_start": 9, "line_end": 9, "text": "‏‏‏ ‏‏‏‏‏ ‏‏ ‏‏‏‏‏ ‏"}, {"surah": 104, "ayah": 6, "line_start": 9, "line_end": 9, "text": "‏‏‏ ‏‏ ‏‏‏‏‏‏‏ ‏"}, {"surah": 104, "ayah": 7, "line_start": 9, "line_end": 10, "text": "‏‏‏ ‏‏‏‏\n‏ ‏‏‏‏‏ ‏"}, {"surah": 104, "ayah": 8, "line_start": 10, "line_end": 10, "text": "‏‏‏‏ ‏‏‏‏‏ ‏‏‏‏‏ ‏"}, {"surah": 104, "ayah": 9, "line_start": 10, "line_end": 10, "text": "‏ ‏‏‏ ‏‏‏‏‏ ‏\n"}, {"surah": 105, "ayah": 1, "line_start": 13, "line_end": 13, "text": "‏‏‏ ‏‏ ‏‏‏ ‏‏‏ ‏‏‏ ‏‏‏‏‏ ‏‏‏‏‏ ‏"}, {"surah": 105, "ayah": 2, "line_start": 13, "line_end": 14, "text": "‏‏‏ ‏‏‏\n‏‏‏‏‏ ‏ ‏‏‏‏‏ ‏"}, {"surah": 105, "ayah": 3, "line_start": 14, "line_end": 14, "text": "‏‏‏‏‏ ‏‏‏‏‏ ‏‏‏‏ ‏‏‏‏‏‏ ‏\n"}, {"surah": 105, "ayah": 4, "line_start": 15, "line_end": 15, "text": "‏‏‏‏‏‏ ‏‏‏‏‏ ‏‏ ‏‏‏‏ ‏"}, {"surah": 105, "ayah": 5, "line_start": 15, "line_end": 15, "text": "‏‏‏‏‏‏ ‏‏‏‏ ‏‏‏‏‏ ‏\n"}]}