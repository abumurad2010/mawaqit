{"page": 603, "ayahs": [{"surah": 109, "ayah": 1, "line_start": 3, "line_end": 3, "text": "‏‏ ‏‏‏‏‏ ‏‏‏‏‏‏‏‏ ‏"}, {"surah": 109, "ayah": 2, "line_start": 3, "line_end": 3, "text": "‏ ‏‏‏‏ ‏‏ ‏‏‏‏‏‏ ‏\n"}, {"surah": 109, "ayah": 3, "line_start": 4, "line_end": 4, "text": "‏‏ ‏‏‏‏ ‏‏‏‏‏ ‏‏ ‏‏‏‏ ‏"}, {"surah": 109, "ayah": 4, "line_start": 4, "line_end": 4, "text": "‏‏ ‏‏‏ ‏‏‏ ‏‏ ‏‏‏‏‏ ‏\n"}, {"surah": 109, "ayah": 5, "line_start": 5, "line_end": 5, "text": "‏‏ ‏‏‏‏ ‏‏‏‏‏ ‏‏ ‏‏‏‏ ‏"}, {"surah": 109, "ayah": 6, "line_start": 5, "line_end": 5, "text": "‏‏‏ ‏‏‏‏‏ ‏‏ ‏‏‏ ‏\n"}, {"surah": 110, "ayah": 1, "line_start": 8, "line_end": 8, "text": "‏‏‏ ‏‏‏ ‏‏‏ ‏‏ ‏‏‏‏‏‏ ‏"}, {"surah": 110, "ayah": 2, "line_start": 8, "line_end": 9, "text": "‏‏‏‏‏‏ ‏‏‏‏\n‏‏‏‏‏‏ ‏ ‏‏‏ ‏‏ ‏‏‏‏‏‏ ‏"}, {"surah": 110, "ayah": 3, "line_start": 9, "line_end": 10, "text": "‏‏‏‏ ‏‏‏ ‏‏‏\n‏‏‏‏‏‏‏‏‏ ‏‏‏‏ ‏‏ ‏‏‏‏‏ ‏\n"}, {"surah": 111, "ayah": 1, "line_start": 13, "line_end": 13, "text": "‏‏‏ ‏‏‏ ‏‏ ‏‏‏ ‏‏‏ ‏"}, {"surah": 111, "ayah": 2, "line_start": 13, "line_end": 13, "text": "‏‏ ‏‏‏ ‏‏‏ ‏‏‏‏ ‏‏‏ ‏‏‏ ‏\n"}, {"surah": 111, "ayah": 3, "line_start": 14, "line_end": 14, "text": "‏‏‏‏ ‏‏‏‏ ‏‏‏ ‏‏‏ ‏"}, {"surah": 111, "ayah": 4, "line_start": 14, "line_end": 14, "text": "‏‏‏‏‏‏‏‏ ‏‏‏‏ ‏‏‏‏ ‏\n"}, {"surah": 111, "ayah": 5, "line_start": 15, "line_end": 15, "text": "‏ ‏‏‏‏‏ ‏‏‏ ‏‏ ‏‏‏ ‏\n"}]}